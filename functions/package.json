{
  "name": "focus-cash-functions",
  "private": true,
  "description": "Focus Cash 서버 — 돈이 움직이는 경로(정산·교환·룰렛·응모·카카오 인증)를 클라이언트 밖으로 옮긴다",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test lib/**/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "set-admin": "tsc && node lib/scripts/set-admin.js"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.8.0"
  }
}
